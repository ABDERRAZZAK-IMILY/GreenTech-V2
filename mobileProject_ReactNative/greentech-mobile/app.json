{
  "expo": {
    "name": "greentech-mobile",
    "slug": "greentech-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "package": "com.greentech.mobile"
    },
    "ios": {
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GreenTech needs your location to track eco-friendly transport in real-time.",
        "NSLocationAlwaysUsageDescription": "GreenTech needs your location to track eco-friendly transport in real-time.",
        "NSLocationWhenInUseUsageDescription": "GreenTech needs your location to track eco-friendly transport in real-time.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "c773a627-dd69-4c50-806c-48c8a471c08b"
      }
    }
  },
  "web": {
    "favicon": "./assets/favicon.png"
  }
}
