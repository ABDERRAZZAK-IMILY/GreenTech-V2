      "codeContent": "\n        // 💡 التحقق من وجود المتجهات (لضمان عدم تكرار الفهرسة)\n        if (vectorStore.similaritySearch(\"Check store count\", 1).size() \u003e 0) {\n            log.info(\"Vector Store already contains data. Skipping MongoDB ingestion.\");\n            return;\n        }\n\n        log.info(\"🔄 Starting ingestion of all data from MongoDB...\");\n\n        List\u003cDocument\u003e allDocuments \u003d new ArrayList\u003c\u003e();\n\n        // ----------------------------------------------------\n        // A. STATIC CONTEXT (Department, Users, Vehicles)\n        // ----------------------------------------------------\n\n        // 1. Departments\n        List\u003cDepartment\u003e departments \u003d departmentRepository.findAll();\n        List\u003cDocument\u003e departmentDocs \u003d departments.stream().map(d -\u003e {\n            String usersList \u003d d.getUsers().stream()\n                    .map(User::getName)\n                    .reduce(\"\", (a, b) -\u003e a.isEmpty() ? b : a + \", \" + b);\n            // Content in English\n            String content \u003d \"Department: \" + d.getName() +\n                    \", Employees: \" + (usersList.isEmpty() ? \"None\" : usersList);\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(departmentDocs);\n\n        // 2. Users\n        List\u003cUser\u003e users \u003d userRepository.findAll();\n        List\u003cDocument\u003e userDocs \u003d users.stream().map(u -\u003e {\n            // Content in English\n            String content \u003d \"User: \" + u.getName() +\n                    \", Email: \" + u.getEmail() +\n                    \", Job Title: \" + u.getJobTitle() +\n                    \", Role: \" + u.getRole().name();\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(userDocs);\n\n        // 3. Vehicles\n        List\u003cVehicleLog\u003e vehicles \u003d vehicleRepository.findAll();\n        List\u003cDocument\u003e vehicleDocs \u003d vehicles.stream().map(v -\u003e {\n            String driver \u003d (v.IntellijIdeaRulezzz() !\u003d null) ? v.getUser().getName() : \"Unassigned\";\n            // Content in English\n            String content \u003d \"Vehicle: \" + v.getModel() +\n                    \", License Plate: \" + v.getLicensePlate() +\n                    \", Assigned Driver: \" + driver;\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(vehicleDocs);\n\n        // ----------------------------------------------------\n        // B. MONITORING DATA (Sensor Readings)\n        // ----------------------------------------------------\n\n        // 4. Energy (تم التصحيح لاستخدام EnergyRepository الذي يجلب كائنات Energy)\n        List\u003cEnergy\u003e energies \u003d energyRepository.findAll();\n        List\u003cDocument\u003e energyDocs \u003d energies.stream().map(e -\u003e {\n            // Content in English\n            String content \u003d \"Energy Reading: Consumed \" + e.getEnergyConsumed() + \" units,\" +\n                    \" Recorded at: \" + e.getCreatedAt();\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(energyDocs);\n\n        // 5. Gas (تم التصحيح لاستخدام GasRepository الذي يجلب كائنات Gas)\n        List\u003cGas\u003e gases \u003d gasRepository.findAll();\n        List\u003cDocument\u003e gasDocs \u003d gases.stream().map(g -\u003e {\n            // Content in English\n            String content \u003d \"Gas Reading: Type \" + g.getGasType() +\n                    \", Consumed: \" + g.getConsumedGas() +\n                    \", Status: \" + g.getStatus() +\n                    \", Usage: \" + g.getUsage();\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(gasDocs);\n\n        // 6. Trash (تم التصحيح لاستخدام TrashRepository الذي يجلب كائنات Trash)\n        List\u003cTrash\u003e trashItems \u003d trashRepository.findAll();\n        List\u003cDocument\u003e trashDocs \u003d trashItems.stream().map(t -\u003e {\n            // Content in English\n            String content \u003d \"Trash Reading: Weight \" + t.getWight() + \" kg,\" +\n                    \" Recorded at: \" + t.getCreatedAt();\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(trashDocs);\n\n        // 7. Smart Data (كما هو)\n        List\u003cSmartData\u003e smartDataList \u003d smartDataRepository.findAll();\n        List\u003cDocument\u003e smartDataDocs \u003d smartDataList.stream().map(d -\u003e {\n            String content \u003d \"Smart Data: Type \" + d.getDataType() + \", Value: \" + d.getValue();\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(smartDataDocs);\n\n        // 8. Vehicle Logs (جديد - لإضافة بيانات VehicleLog)\n        List\u003cVehicleLog\u003e vehicleLogs \u003d vehicleLogRepository.findAll();\n        List\u003cDocument\u003e vehicleLogDocs \u003d vehicleLogs.stream().map(vl -\u003e {\n            String content \u003d \"Vehicle Log: ID \" + vl.getVehicleId() +\n                    \", Location: (\" + vl.getLatitude() + \", \" + vl.getLongitude() + \")\" +\n                    \", Time: \" + vl.getCreatedAt();\n            return new Document(content);\n        }).toList();\n        allDocuments.addAll(vehicleLogDocs);\n\n\n        // --- FINAL SAVE ---\n        if (allDocuments.isEmpty()) {\n            log.warn(\"⚠️ No data found to read! Ensure MongoDB contains documents.\");\n            return;\n        }\n\n        vectorStore.add(allDocuments);\n\n        // حفظ المتجر على القرص لتجنب إعادة الفهرسة في المرة القادمة\n        if (this.vectorStore instanceof SimpleVectorStore) {\n            ((SimpleVectorStore) this.vectorStore).save(vectorStoreFile);\n        }\n\n        log.info(\"✅ SUCCESS: Loaded and saved \" + allDocuments.size() + \" documents to Vector Store",
